+// Disposable trace build only. Keep a complete candidate list so the analysis
+// can distinguish equal ordered batches from merely overlapping shortlists.
+#ifdef NG63_TRACE
+void trace_roll(bool reading, int path, int roll, const Board& board,
+                const EvalCtx& ctx, const std::vector<Board>& evaluated,
+                bool full_hit) {
+    static constexpr char hex[] = "0123456789abcdef";
+    std::string boards;
+    auto append = [&](const Board& b) {
+        for (int point : b) {
+            unsigned char v = static_cast<unsigned char>(point);
+            boards += hex[v >> 4];
+            boards += hex[v & 15];
+        }
+    };
+    append(board);
+    for (const auto& candidate : evaluated) append(candidate);
+    // One stdio call keeps each roll intact across parallel workers.
+    std::fprintf(stderr, "NG63 roll %d %d %d %llu %d %d %s\n",
+        reading, path, roll, static_cast<unsigned long long>(ctx.strategy->eval_identity()),
+        ctx.pinned_nn, full_hit, boards.c_str());
+}
+#endif
